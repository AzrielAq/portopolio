:root{--bg:#EFEBF7;--ink:#1D1A3F;--soft:#59567D;--line:#CCC5E4;--accent:#FF5A36;--mint:#8FE3C8;--pad:clamp(1.25rem,5vw,4rem)}
[data-theme=dark]{--bg:#15132B;--ink:#F0EDFA;--soft:#A9A5CF;--line:#38346A;--accent:#FF8A6B}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth;scroll-padding-top:4.5rem}
body{background:var(--bg);color:var(--ink);font:400 1.0625rem/1.65 "DM Sans",system-ui,sans-serif;transition:background .3s,color .3s}
h1,h2,.t,.logo{font-family:"Bricolage Grotesque","DM Sans",sans-serif}
a{color:inherit;text-decoration-color:var(--accent);text-decoration-thickness:2px;text-underline-offset:4px}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}

.top{position:sticky;top:0;z-index:5;display:flex;justify-content:space-between;align-items:center;padding:.9rem var(--pad);background:color-mix(in srgb,var(--bg) 88%,transparent);backdrop-filter:blur(8px)}
.logo{font-weight:700;text-decoration:none;font-size:1.1rem}
nav{display:flex;align-items:center;gap:1.4rem}
nav a{text-decoration:none;font-size:.95rem;color:var(--soft)}
nav a:hover{color:var(--ink)}
#tema{width:2.4rem;height:2.4rem;border-radius:50%;border:2px solid var(--ink);background:linear-gradient(90deg,var(--ink) 50%,transparent 50%);cursor:pointer}

main{padding:0 var(--pad)}
.hero{min-height:calc(100svh - 4rem);display:flex;flex-direction:column;justify-content:center;gap:2.5rem;padding:2rem 0}
.name{font-size:clamp(3.6rem,17vw,13rem);line-height:.88;font-weight:500;letter-spacing:-.03em}
.name .w{display:block}
.name .l{display:inline-block;font-variation-settings:"wght" 500;transition:font-variation-settings .25s ease-out}
.name .w:last-child{color:transparent;-webkit-text-stroke:2px var(--ink)}
.hero-bottom{display:flex;flex-wrap:wrap;gap:1.5rem 3rem;align-items:center;justify-content:space-between}
.hero-bottom p{max-width:34ch;font-size:1.2rem}
.actions{display:flex;gap:.8rem;flex-wrap:wrap}
.btn{padding:.8rem 1.5rem;border:2px solid var(--ink);border-radius:999px;text-decoration:none;font-weight:500;transition:transform .15s}
.btn:hover{transform:translateY(-2px)}
.btn.primary{background:var(--ink);color:var(--bg)}

.block{padding:5rem 0;border-top:1px solid var(--line);display:grid;grid-template-columns:minmax(9rem,1fr) 3fr;gap:2rem}
.block h2{font-size:1.6rem;font-weight:700;line-height:1.2}
.cols{display:grid;grid-template-columns:3fr 2fr;gap:2.5rem}
.cols p{max-width:60ch}
dl{display:grid;grid-template-columns:auto 1fr;gap:.6rem 1.5rem}
dt{color:var(--soft)}dd{font-weight:500}

.list details{border-bottom:1px solid var(--line)}
.list details:first-child{border-top:1px solid var(--line)}
summary{display:flex;justify-content:space-between;gap:1rem;align-items:baseline;flex-wrap:wrap;padding:1.2rem 0;cursor:pointer;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"+";font-size:1.5rem;width:1.5rem;color:var(--accent);font-weight:700;transition:transform .25s}
details[open] summary::before{transform:rotate(45deg)}
.t{flex:1;font-size:clamp(1.2rem,3vw,1.7rem);font-weight:600;line-height:1.2}
.m{color:var(--soft);font-size:.95rem}
details p{padding:0 0 1.4rem 1.5rem;max-width:62ch;color:var(--soft)}
details p a{color:var(--ink)}

.skills{list-style:none;padding:0;display:flex;flex-wrap:wrap;gap:.7rem;align-content:flex-start}
.skills li{padding:.45rem 1.1rem;border:2px solid var(--ink);border-radius:999px;font-weight:500}
.skills li:nth-child(3n+1){background:var(--mint);color:#15132B;border-color:var(--mint)}

.contact{grid-template-columns:minmax(9rem,1fr) 3fr;align-items:start}
.contact .mail{grid-column:2;font-family:"Bricolage Grotesque",sans-serif;font-weight:600;font-size:clamp(1.5rem,5.5vw,3.4rem);line-height:1.1;overflow-wrap:anywhere}
.links{grid-column:2;display:flex;gap:1.5rem;flex-wrap:wrap}
footer{padding:2rem var(--pad);color:var(--soft);font-size:.9rem;border-top:1px solid var(--line)}

@media(max-width:720px){
  nav a{display:none}
  .block,.contact{grid-template-columns:1fr;padding:3.5rem 0;gap:1.25rem}
  .cols{grid-template-columns:1fr}
  .contact .mail,.links{grid-column:1}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
